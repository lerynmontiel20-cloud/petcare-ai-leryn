# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SUPABASE_URL: URL de tu proyecto en Supabase (ej. https://xxxx.supabase.co)
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Clave privada de Supabase (solo servidor, nunca exponer al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_ANON_KEY: Alternativa opcional si habilitas politicas publicas en Supabase
SUPABASE_ANON_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Clave publica restringida por HTTP referrer para Google Maps JS API
VITE_GOOGLE_MAPS_API_KEY=
